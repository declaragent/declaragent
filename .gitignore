node_modules
dist
# …but force-track test fixture `dist/` dirs. They're hand-authored
# TS files dynamically imported at runtime by plugin loader tests —
# they never come from a compiler, so the blanket `dist` rule above
# was silently dropping them and every CI run had 4 failing
# loadPlugin (fixture) tests as a result.
!packages/core/src/plugins/__fixtures__/**/dist/
!packages/core/src/plugins/__fixtures__/**/dist/**
build
coverage
.DS_Store
*.log
.env
.env.*
!.env.example
.turbo
.cache
*.tsbuildinfo
# Docusaurus cache (docs-site/)
.docusaurus
# Credentials — defensive, should never land in the repo
.npmrc
# Runtime state created by `declaragent fleet run` + the daemon
.declaragent/
# Claude Code local agent state
.claude/
# macOS noise
.DS_Store
# `/docs/` is now checked in (planning docs are visible in-repo + used
# by CI). The public Docusaurus surface remains at `docs-site/docs/`.
# Compiled standalone binary (built by `bun build --compile`; 62 MB)
packages/cli/bin/declaragent-binary/
# chaos:quick report artifacts (testkit/scripts/chaos-quick.ts writes
# timestamped JSON + Markdown reports on every run; CI uploads them
# as artifacts, local runs should not clutter the tree).
packages/testkit/chaos-report.*.json
packages/testkit/chaos-report.*.md
