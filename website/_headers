# Cloudflare Pages headers — cache static assets, never cache HTML.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

# Markdown + env: historically we deployed a handful of internal
# ops docs in this directory by mistake. They've been moved to
# docs/website/ and are no longer in the bundle, but Cloudflare's
# edge may still have cached copies for up to s-maxage. Force a
# revalidate on every hit so the next request surfaces the real
# 404 from origin and evicts the stale object.
/*.md
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=0
  CDN-Cache-Control: public, max-age=0
  Cloudflare-CDN-Cache-Control: public, max-age=0

/.env
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=0
  CDN-Cache-Control: public, max-age=0
  Cloudflare-CDN-Cache-Control: public, max-age=0

# `immutable` is a trap for un-versioned filenames — browsers never
# revalidate. Until we hash the filenames (content-addressed build
# output), use `must-revalidate` so Cloudflare can 304 quickly but
# the browser does check for freshness on every load.
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/*.svg
  Cache-Control: public, max-age=86400, must-revalidate

# install.sh — piped into `sh` via curl. Serve as plain text so
# browsers don't try to render it, and keep the cache short so a
# fix to the installer lands fast for everyone.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
