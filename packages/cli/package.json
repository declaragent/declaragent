{
  "name": "@declaragent/cli",
  "version": "0.4.1",
  "description": "Interactive REPL for Declaragent.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "declaragent": "./bin/declaragent.js",
    "d9t": "./bin/declaragent.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin/declaragent.js",
    "bin/postinstall.js",
    "bin/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "bun scripts/write-version.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun scripts/write-version.ts && tsc --noEmit",
    "dev": "bun scripts/write-version.ts && bun run src/index.tsx",
    "clean": "rm -rf dist bin/declaragent-binary",
    "postinstall": "node ./bin/postinstall.js"
  },
  "dependencies": {
    "@declaragent/core": "^0.2.2",
    "@declaragent/plugin-agent-rpc": "^1.0.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@declaragent/channel-whatsapp": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react-devtools-core": "^4.28.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
