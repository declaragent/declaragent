{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus instance scraping declaragent channel metrics (via the OTel collector's Prometheus exporter).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Declaragent channels — per-channel outbound throughput, success rate, failure reason breakdown, idempotency hit rate, and p99 send latency. Panels filter by channel `type` (telegram / slack / discord / whatsapp) and break down per channel `id`. Backed by `BaseChannelInstance` slice-14 metrics: `channel.outbound.sent`, `channel.outbound.failed`, `channel.outbound.idempotency_hits`, `channel.outbound.rate_limit_retries`, `channel.outbound.latency_ms`.",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "iteration": 1,
  "links": [],
  "templating": {
    "list": [
      {
        "name": "type",
        "label": "Channel type",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(channel_outbound_sent_total, type)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total channels",
      "datasource": "${DS_PROMETHEUS}",
      "id": 100,
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "options": { "colorMode": "value", "textMode": "value" },
      "targets": [
        {
          "expr": "count(count by (id) (channel_outbound_sent_total{type=~\"$type\"}))",
          "legendFormat": "channels",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Outbound sent (total)",
      "datasource": "${DS_PROMETHEUS}",
      "id": 101,
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "expr": "sum(channel_outbound_sent_total{type=~\"$type\"})",
          "legendFormat": "sent",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Outbound failed rate (1m)",
      "datasource": "${DS_PROMETHEUS}",
      "id": 102,
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(channel_outbound_failed_total{type=~\"$type\"}[1m]))",
          "legendFormat": "failed/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Idempotency hit rate (1m)",
      "description": "Cache hits / (cache hits + successful sends). A high sustained rate (> 10%) suggests retry storms upstream.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 103,
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(channel_outbound_idempotency_hits_total{type=~\"$type\"}[1m])) / clamp_min(sum(rate(channel_outbound_idempotency_hits_total{type=~\"$type\"}[1m])) + sum(rate(channel_outbound_sent_total{type=~\"$type\"}[1m])), 1)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Rate-limit retries (1m)",
      "datasource": "${DS_PROMETHEUS}",
      "id": 104,
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(channel_outbound_rate_limit_retries_total{type=~\"$type\"}[1m]))",
          "legendFormat": "retries/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Inbound received (1m)",
      "datasource": "${DS_PROMETHEUS}",
      "id": 105,
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(channel_inbound_received_total{type=~\"$type\"}[1m]))",
          "legendFormat": "inbound/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbound throughput — sent vs. failed (per channel)",
      "description": "Messages per second successfully delivered vs. failed after retries. A healthy channel has failed ≈ 0.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 110,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "rate(channel_outbound_sent_total{type=~\"$type\"}[1m])",
          "legendFormat": "sent {{id}}",
          "refId": "A"
        },
        {
          "expr": "sum by (id) (rate(channel_outbound_failed_total{type=~\"$type\"}[1m]))",
          "legendFormat": "failed {{id}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbound success rate (per channel)",
      "description": "sent / (sent + failed). Alert when it drops below 99% sustained for 5 min.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 111,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "lineWidth": 1 }
        }
      },
      "targets": [
        {
          "expr": "rate(channel_outbound_sent_total{type=~\"$type\"}[1m]) / clamp_min(rate(channel_outbound_sent_total{type=~\"$type\"}[1m]) + sum by (id, type) (rate(channel_outbound_failed_total{type=~\"$type\"}[1m])), 1)",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed sends by reason",
      "description": "Breakdown of failed sends by failure class. `rate-limit` = 429 retry exhausted; `error` = non-rate-limit error path (breaker open, network, 5xx, etc).",
      "datasource": "${DS_PROMETHEUS}",
      "id": 120,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(channel_outbound_failed_total{type=~\"$type\"}[1m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbound p50 / p95 / p99 latency",
      "description": "End-to-end `send()` latency: outbound rate-limiter acquire + render + `doSend`. Does not include bridge queueing.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 121,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, id) (rate(channel_outbound_latency_ms_bucket{type=~\"$type\"}[1m])))",
          "legendFormat": "p50 {{id}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, id) (rate(channel_outbound_latency_ms_bucket{type=~\"$type\"}[1m])))",
          "legendFormat": "p95 {{id}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, id) (rate(channel_outbound_latency_ms_bucket{type=~\"$type\"}[1m])))",
          "legendFormat": "p99 {{id}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Idempotency + rate-limit retries (per channel)",
      "description": "Short-circuited sends (cache hits) and one-shot 429 retries. Both should be low-frequency; persistent growth means upstream retry loops or a mis-tuned outbound rate limit.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 130,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "rate(channel_outbound_idempotency_hits_total{type=~\"$type\"}[1m])",
          "legendFormat": "idem-hits {{id}}",
          "refId": "A"
        },
        {
          "expr": "rate(channel_outbound_rate_limit_retries_total{type=~\"$type\"}[1m])",
          "legendFormat": "rate-retries {{id}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Typing + reactions + edits (per channel)",
      "description": "Secondary-action throughput. Useful for catching a skill that stops emitting typing indicators (UX regression) or reacts on a broken webhook.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 131,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "rate(channel_typing_sent_total{type=~\"$type\"}[1m])",
          "legendFormat": "typing {{id}}",
          "refId": "A"
        },
        {
          "expr": "rate(channel_reactions_sent_total{type=~\"$type\"}[1m])",
          "legendFormat": "reactions {{id}}",
          "refId": "B"
        },
        {
          "expr": "rate(channel_outbound_edited_total{type=~\"$type\"}[1m])",
          "legendFormat": "edits {{id}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Inbound received vs. failed (per channel)",
      "description": "Messages ingested from the platform vs. failures to publish onto the bus. Failed spikes typically mean dispatcher pressure or a malformed event.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 140,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "rate(channel_inbound_received_total{type=~\"$type\"}[1m])",
          "legendFormat": "received {{id}}",
          "refId": "A"
        },
        {
          "expr": "rate(channel_inbound_failed_total{type=~\"$type\"}[1m])",
          "legendFormat": "failed {{id}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["declaragent", "channels", "phase-5"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Declaragent — Channels",
  "uid": "declaragent-channels",
  "version": 1,
  "weekStart": ""
}
