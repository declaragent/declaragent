{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus instance scraping declaragent metrics (via the OTel collector's Prometheus exporter).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Declaragent event sources — throughput, latency, DLQ, lag, and connection-error overview. Backed by OTel metrics exported via the Prometheus exporter (see packages/testkit/observability).",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "iteration": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Total sources",
      "datasource": "${DS_PROMETHEUS}",
      "id": 100,
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "count(count by (id) (source_messages_received))",
          "legendFormat": "sources",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total messages processed",
      "datasource": "${DS_PROMETHEUS}",
      "id": 101,
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "expr": "sum(source_messages_processed)",
          "legendFormat": "processed",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DLQ rate (1m)",
      "datasource": "${DS_PROMETHEUS}",
      "id": 102,
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(source_messages_dlq[1m]))",
          "legendFormat": "dlq/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Connection errors (1m)",
      "datasource": "${DS_PROMETHEUS}",
      "id": 103,
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(source_connection_errors[1m]))",
          "legendFormat": "errors/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Inflight (all sources)",
      "datasource": "${DS_PROMETHEUS}",
      "id": 104,
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 0 },
      "options": { "colorMode": "value" },
      "targets": [{ "expr": "sum(source_inflight)", "legendFormat": "inflight", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Failed rate (1m)",
      "datasource": "${DS_PROMETHEUS}",
      "id": 105,
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(source_messages_failed[1m]))",
          "legendFormat": "failed/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput — received vs. processed (per source)",
      "description": "Messages per second the source pulled from the transport vs. successfully published to the bus. A healthy source has processed ≈ received.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 110,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "rate(source_messages_received[1m])",
          "legendFormat": "received {{id}}",
          "refId": "A"
        },
        {
          "expr": "rate(source_messages_processed[1m])",
          "legendFormat": "processed {{id}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Processing duration — p50 / p95 / p99",
      "description": "End-to-end latency from transport receive to bus publish. Acceptance bar is p99 < 5000ms at 1K msg/sec (slice 16).",
      "datasource": "${DS_PROMETHEUS}",
      "id": 111,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, id) (rate(source_process_duration_ms_bucket[1m])))",
          "legendFormat": "p50 {{id}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, id) (rate(source_process_duration_ms_bucket[1m])))",
          "legendFormat": "p95 {{id}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, id) (rate(source_process_duration_ms_bucket[1m])))",
          "legendFormat": "p99 {{id}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DLQ rate (per source)",
      "description": "Messages/sec exhausting their retry budget and landing in the DLQ. Spike → investigate handler errors.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 120,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "rate(source_messages_dlq[1m])",
          "legendFormat": "dlq {{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed rate (per source)",
      "description": "Messages/sec that threw during processing (may be retried). Compare against DLQ rate.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 121,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "rate(source_messages_failed[1m])",
          "legendFormat": "failed {{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Inflight handlers (per source)",
      "description": "Current number of in-flight message handlers. Clamped above by the adapter's `limits.concurrency`. Persistent saturation → raise concurrency or investigate downstream latency.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 130,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 }
        }
      },
      "targets": [{ "expr": "source_inflight", "legendFormat": "{{id}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Connection errors (per source)",
      "description": "Transport-level reconnect/auth failures. Intermittent is OK; sustained points at broker / network / auth.",
      "datasource": "${DS_PROMETHEUS}",
      "id": 131,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1 } }
      },
      "targets": [
        {
          "expr": "rate(source_connection_errors[1m])",
          "legendFormat": "errors {{id}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["declaragent", "event-sources", "phase-4"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Declaragent — Event Sources",
  "uid": "declaragent-event-sources",
  "version": 1,
  "weekStart": ""
}
