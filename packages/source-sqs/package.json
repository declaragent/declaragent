{
  "name": "@declaragent/source-sqs",
  "version": "2.0.1",
  "description": "AWS SQS event source adapter for Declaragent (Phase 4).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@declaragent/core": "^0.3.1"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.645.0"
  },
  "declaragent": {
    "kind": "event-source-adapter",
    "type": "sqs",
    "agent_compat": ">=0.0.1"
  }
}
