# Anthropic API key. Reviews run against Sonnet 4.5 for diff comprehension.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# GitHub personal access token (fine-grained recommended). Needs:
#   - Repository > Contents: read
#   - Repository > Pull requests: read & write
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=ghp_...

# GitHub webhook shared secret. Set the same value when configuring the
# webhook in the repo's Settings → Webhooks page. Choose a long random
# string; `openssl rand -hex 32` works.
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-32-byte-hex

# Optional: limit reviews to a single repo. Omit to review every repo
# the webhook fires for. Format: `owner/repo`.
# GITHUB_REPO_ALLOWLIST=my-org/my-repo
