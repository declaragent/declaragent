# Anthropic API key (uses Haiku by default; cheap + fast).
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Alertmanager shared secret. Used to HMAC-verify inbound webhook
# requests. Set the matching value in `alertmanager.yml`:
#   receivers:
#     - name: declaragent
#       webhook_configs:
#         - url: https://your-host/webhook/alertmanager
#           http_config:
#             authorization:
#               type: Bearer
#               credentials: <this value>
ALERTMANAGER_WEBHOOK_SECRET=change-me-to-a-random-32-byte-hex

# Slack bot token (xoxb-...) with `chat:write` + `im:write` scopes.
SLACK_BOT_TOKEN=xoxb-...

# Slack app-level token (xapp-...) — Socket Mode transport.
SLACK_APP_TOKEN=xapp-...

# Slack user id of the human on-call. Format: U0123ABCD.
# Find it under "View profile" → "More" → "Copy member ID" in Slack.
SLACK_ONCALL_USER_ID=U01234567
