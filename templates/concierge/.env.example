# Anthropic API key. Used by the engine to call Claude.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Slack bot user OAuth token (xoxb-...).
# Create a Slack app at https://api.slack.com/apps, enable Socket Mode,
# install it to your workspace, and copy the Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-...

# Slack app-level token (xapp-...) with the `connections:write` scope.
# Required for Socket Mode. Created under "Basic Information" →
# "App-Level Tokens" in the Slack app settings.
SLACK_APP_TOKEN=xapp-...
