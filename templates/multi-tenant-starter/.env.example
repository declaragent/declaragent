# Anthropic API key. One key services both tenants; token usage is
# accounted per-tenant via the daemon's quota tracker.
ANTHROPIC_API_KEY=sk-ant-...

# Vault bootstrap creds. Both tenants resolve `secret:...` refs via
# the same Vault cluster, scoped per-tenant by `secretScopes` in
# tenants.yaml. See secrets.yaml for the provider wiring.
VAULT_ADDRESS=https://vault.example.com
VAULT_ROLE_ID=<approle role-id>
VAULT_SECRET_ID=<approle secret-id>

# Per-tenant Slack tokens. These live in Vault in production; this
# fallback is only for local dev. The real flow resolves
# `${secret:acme/slack/bot-token}` through the Vault provider.
ACME_SLACK_BOT_TOKEN=xoxb-acme-...
ACME_SLACK_APP_TOKEN=xapp-acme-...
BETA_SLACK_BOT_TOKEN=xoxb-beta-...
BETA_SLACK_APP_TOKEN=xapp-beta-...
