# Env for the marketing template. Copy to .env and fill in.
# LLM provider key (Anthropic by default).
ANTHROPIC_API_KEY=

# Slack channel — bot + app tokens and the review channel id.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_MARKETING_REVIEW_CHANNEL_ID=

# Brave Search MCP / tool key for market research.
BRAVE_API_KEY=

# PostHog analytics host (e.g. https://us.posthog.com).
POSTHOG_HOST=
