# Anthropic API key. Haiku 4.5 is used per-message for cost.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Kafka broker list. For local dev with the bundled docker-compose,
# use `localhost:19092`.
# For production Confluent Cloud / MSK / Redpanda Cloud, use the
# broker URL from your cloud console.
KAFKA_BROKER_URL=localhost:19092

# Kafka SASL credentials. Leave blank for local Redpanda without auth
# (the docker-compose file ships with SASL disabled for the dev loop),
# and delete the `security.sasl` block from event-sources.yaml.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
